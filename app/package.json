{
  "name": "ti-matrix-app",
  "productName": "Ti Matrix",
  "version": "0.1.0",
  "description": "The desktop app for the ti-matrix engine — worlds, search trees, and a confirmer with buttons.",
  "private": true,
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "cross-env VITE_DEV=1 electron .",
    "build": "tsc -p tsconfig.node.json && vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test:parsers": "esbuild renderer/parsers.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/parsers.test.cjs --log-level=error && node node_modules/.cache/parsers.test.cjs",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
